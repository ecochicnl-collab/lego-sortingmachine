using UnityEngine;
using UnityEngine.UI;
using TMPro;
using System.Collections.Generic;

public class LegoGridUi : MonoBehaviour
{
    private List<GameObject> alleStenen = new List<GameObject>();
    private int geselecteerdeBreedte = -1;
    private int geselecteerdeLengte = -1;

    public GameObject knopPrefab;

    public void OnGridKnopGeklikt(int breedte, int lengte)
    {
        if (geselecteerdeBreedte == breedte && geselecteerdeLengte == lengte)
        {
            geselecteerdeBreedte = -1;
            geselecteerdeLengte = -1;
            Debug.Log("[GridUI] filter uitgeschakeld. toon alles.");
        }
        else
        {
            geselecteerdeBreedte = breedte;
            geselecteerdeLengte = lengte;
            Debug.Log($"[GridUI] filter ingesteld op exact: {breedte} x {lengte}");
        }

        UpdateInformatie();
    }

    private void UpdateInformatie()
    {
        int getoond = 0;

        foreach (var steen in alleStenen)
        {
            if (steen == null) continue;

            bool match = true;
            if (geselecteerdeBreedte != -1 || geselecteerdeLengte != -1)
            {
                string naam = steen.name ?? string.Empty;
                match = naam.Contains($"{geselecteerdeBreedte}x{geselecteerdeLengte}");
            }

            steen.SetActive(match);
            if (match) getoond++;
        }

        Debug.Log($"[GridUI] filteren klaar! totaal in scene: {alleStenen.Count} | match met filter: {getoond} blokjes getoond.");
    }

    private void Start()
    {
        alleStenen.Clear();

        GridLayoutGroup grid = GetComponent<GridLayoutGroup>();
        if (grid == null) grid = gameObject.AddComponent<GridLayoutGroup>();

        grid.constraint = GridLayoutGroup.Constraint.FixedColumnCount;
        grid.constraintCount = 8;
        grid.cellSize = new Vector2(100f, 100f);
        grid.spacing = new Vector2(12f, 12f);

        for (int breedte = 1; breedte <= 8; breedte++)
        {
            for (int lengte = 1; lengte <= 8; lengte++)
            {
                int b = breedte;
                int l = lengte;

                GameObject nieuweKnop = Instantiate(knopPrefab, transform);
                nieuweKnop.name = $"{b}x{l}";

                TMP_Text tmpTekst = nieuweKnop.GetComponentInChildren<TMP_Text>();
                if (tmpTekst != null)
                {
                    tmpTekst.text = $"{b}x{l}";
                }
                else
                {
                    Text normaleTekst = nieuweKnop.GetComponentInChildren<Text>();
                    if (normaleTekst != null) normaleTekst.text = $"{b}x{l}";
                }

                Button btn = nieuweKnop.GetComponent<Button>();
                if (btn != null)
                {
                    btn.onClick.AddListener(() => OnGridKnopGeklikt(b, l));
                }

                alleStenen.Add(nieuweKnop);
            }
        }
    }
}
